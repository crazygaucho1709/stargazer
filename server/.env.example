# server/.env.example
# Copier en server/.env et renseigner. Ce fichier ne contient AUCUN secret reel.
# server/.env est ignore par git (.gitignore : .env*).

# --- Raspberry Pi (astroberry) ---
ASTROBERRY_HOST=127.0.0.1
INDI_HOST=127.0.0.1
ASTROBERRY_USER=astroberry
ASTROBERRY_PASS=
ASTROBERRY_PORT=2222

# --- Stockage captures ---
STORAGE_PATH=/Volumes/Data2/captures

# --- Profil Ekos ---
EKOS_PROFILE=Nexstar4SE

# --- Cles IA (optionnelles : l'IA est un bonus degradable) ---
# Anthropic : ecrite aussi par POST /ai/claude/key depuis l'UI
ANTHROPIC_API_KEY=
# Google AI Studio (Gemini). Les appels du backend passent par le compte de
# service (server/firebase-adminsdk.json, non versionne) ; cette cle sert aux
# diagnostics en ligne de commande.
GEMINI_API_KEY=

# Fournisseur impose : "gemini" ou "claude". Quand il est defini, AUCUNE
# bascule vers l'autre n'a lieu et une panne remonte telle quelle. Laisser
# vide pour le choix automatique avec repli.
AI_PROVIDER=gemini

# Modele Gemini utilise pour tous les appels, texte et vision.
# gemini-3.6-flash a ete retenu apres mesure : sur des coordonnees verifiees
# en catalogue il fait mieux que gemini-3.1-pro-preview (0,4' contre 2,0'
# d'ecart maximal en declinaison) tout en etant plus rapide.
GEMINI_MODEL=gemini-3.6-flash

# Plafond de tokens de sortie. Vide = pas de plafond, le modele utilise sa
# propre limite (65536). Les modeles Flash recents decomptent leurs tokens de
# reflexion de ce budget : ~1300 tokens de reflexion pour ~240 de reponse, donc
# toute valeur basse tronque la reponse avant meme qu'elle ne commence.
GEMINI_MAX_OUTPUT_TOKENS=

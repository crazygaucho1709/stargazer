# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf les gabarits, qui ne contiennent aucun secret et documentent
# les variables attendues (voir server/.env.example)
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# telescope captures & stream frames (binary files, not for version control)
/captures/
*.stream_jpg
*.stream.jpg
logs/backend-error.log
certs/

# Service account key — never commit
server/firebase-adminsdk.json

# config locale : contient des cles API (aiKey) et les limites du site
server/config.json

# artefacts Python
__pycache__/
*.pyc

# transcriptions de sessions : contiennent des cles API en clair
scratch/

# graphe de code genere
graphify-out/
